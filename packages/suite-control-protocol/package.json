{
  "name": "@jm/suite-control-protocol",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Suite-weites TCP-Zeilenprotokoll + Server/Client/Capabilities für die Fernsteuerung aller JM-Tools (Bitfocus Companion)",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./capabilities": "./src/capabilities.ts"
  },
  "dependencies": {
    "@jm/auth-core": "*",
    "@jm/discovery": "*"
  },
  "scripts": {
    "selftest": "node --experimental-strip-types test/selftest.ts",
    "test:integration": "esbuild test/integration.ts --bundle --platform=node --format=cjs --outfile=test/integration.bundle.cjs && node test/integration.bundle.cjs"
  }
}
