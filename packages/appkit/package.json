{
  "name": "@jm/appkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dokumentmodell + Laufzeit des JM App Designers — reines Web (kein electron/node), läuft in Editor-Sandbox, Kiosk und exportiertem Bundle",
  "exports": {
    ".": "./src/index.ts",
    "./runtime.js": "./dist/runtime.js"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
